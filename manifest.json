{
  "manifest_version": 3,
  "name": "Venice Vault \u2014 local archive for Venice.ai",
  "short_name": "Venice Vault",
  "version": "0.3.0",
  "description": "__MSG_extensionDescription__",
  "author": "Ante Budimir",
  "default_locale": "en",
  "browser_specific_settings": {
    "gecko": {
      "id": "venice-vault@antebudimir.dev",
      "strict_min_version": "153.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "downloads"
  ],
  "host_permissions": [
    "https://venice.ai/*"
  ],
  "background": {
    "scripts": [
      "background/background.js"
    ],
    "type": "module"
  },
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  }
}
